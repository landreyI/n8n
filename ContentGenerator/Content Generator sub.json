        "query": "SELECT\n  -- Создаем JSON-объект с ключом 'source_contents', который содержит массив всех найденных статей\n  (\n    SELECT jsonb_agg(c)\n    FROM public.contents AS c\n    WHERE c.id = ANY (\n  string_to_array(\n    '{{ $('When Executed by Another Workflow').item.json.source_content_ids.join(\",\") }}',\n    ','\n  )::uuid[]\n)\n  ) AS source_contents,\n\n  -- Создаем JSON-объект с ключом 'tov_profile', который содержит один найденный профиль\n  (\n    SELECT to_jsonb(t)\n    FROM public.tone_of_voice_profiles AS t\n    WHERE t.id = '{{ $('When Executed by Another Workflow').item.json.tov_id }}'::uuid\n  ) AS tov_profile;",
