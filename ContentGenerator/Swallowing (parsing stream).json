    {
      "parameters": {
        "jsCode": "// 1. Отримуємо вхідне посилання від користувача\nconst url = $input.item.json.url;\n\nlet rss_url = null;\nlet source_type = null;\n\n// 2. \"Маршрутизатор\" + \"Будівельник\"\n// Пріоритет на сторінки компаній, оскільки їх парсинг надійніший\n\nif (url.includes('/company/')) {\n    // --- 1. Сторінка Компанії (Надійний маршрут) ---\n    const companyId = url.split('/company/')[1].split('/')[0];\n    rss_url = `https://rsshub.app/linkedin/company/${companyId}/posts`;\n    source_type = 'company_posts';\n\n} else if (url.includes('/in/')) {\n    // --- 2. Профіль Користувача (Ненадійний маршрут, вимагає Puppeteer) ---\n    const username = url.split('/in/')[1].split('/')[0];\n    \n    // Вирішуємо, що парсити: пости чи статті\n    // За замовчуванням беремо пости\n    let type = 'posts';\n    if (url.includes('/detail/recent-activity/articles/')) {\n        type = 'articles';\n    }\n    \n    rss_url = `https://rsshub.app/linkedin/profile/${username}/${type}`;\n    source_type = 'user_profile';\n\n} else {\n    // Якщо посилання не розпізнано\n    throw new Error(`Непідтримуваний формат URL LinkedIn: ${url}`);\n}\n\n// 3. Повертаємо результат\nreturn {\n  json: {\n    ...$input.item.json,\n    rss_url: rss_url,\n    source_type_linkedin: source_type\n  }\n};"
      },
