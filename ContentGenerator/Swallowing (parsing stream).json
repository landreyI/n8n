      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// 1. Отримуємо вхідне посилання від користувача\nconst url = $input.item.json.url;\n\nlet rss_url = null;\nlet source_type = null;\nlet handle = null;\nlet channelId = null;\n\n// КРИТИЧНО: Ми повинні перевіряти найбільш специфічні посилання (з /posts) ПЕРШИМИ.\n\nif (url.includes('/posts') || url.includes('/community')) {\n    // --- 1. Пости Спільноти (Найвищий пріоритет) ---\n    source_type = 'community';\n    \n    if (url.includes('/@')) {\n        // Формат: https://www.youtube.com/@handle/posts\n        handle = '@' + url.split('/@')[1].split('/')[0];\n        rss_url = `https://rsshub.app/youtube/community/${handle}`;\n    } else if (url.includes('/channel/')) {\n        // Формат: https://www.youtube.com/channel/UC.../community\n        channelId = url.split('/channel/')[1].split('/')[0];\n        rss_url = `https://rsshub.app/youtube/community/${channelId}`;\n    } else {\n        throw new Error('Не вдалося розпарсити @handle або ID каналу зі посилання на спільноту.');\n    }\n\n} else if (url.includes('/playlist?list=')) {\n    // --- 2. Плейлист ---\n    source_type = 'playlist';\n    const playlistId = url.split('?list=')[1].split('&')[0];\n    rss_url = `https://rsshub.app/youtube/playlist/${playlistId}`;\n\n} else if (url.includes('/channel/')) {\n    // --- 3. Канал (Відео) ---\n    source_type = 'channel_video';\n    channelId = url.split('/channel/')[1].split('/')[0];\n    rss_url = `https://rsshub.app/youtube/channel/${channelId}`;\n\n} else if (url.includes('/@') || url.includes('/user/')) {\n    // --- 4. Handle/User (Відео) ---\n    source_type = 'user_video';\n    handle = url.includes('/@') \n      ? '@' + url.split('/@')[1].split('/')[0] \n      : url.split('/user/')[1].split('/')[0];\n      \n    rss_url = `https://rsshub.app/youtube/user/${handle}`;\n\n} else {\n    // Якщо посилання не розпізнано\n    throw new Error(`Непідтримуваний формат URL: ${url}`);\n}\n\n// 3. Повертаємо результат\nreturn {\n  json: {\n    ...$input.item.json, // Зберігаємо всі вхідні дані\n    rss_url: rss_url,\n    source_type_youtube: source_type\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        224
      ],
